{
  "name": "lunch-together",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lunch-together",
      "database_id": "1b86cb9e-a72c-4987-92a7-858c9af4c77e"
    }
  ]
}
